# Copy to tests/.env. The test database is wiped and reinstalled on every run:
# never point this at a site's database.
#
# For DDEV (run the tests inside the web container):
#   ddev mysql -uroot -proot -e "CREATE DATABASE recurrence_test; GRANT ALL ON recurrence_test.* TO 'db'@'%';"

CRAFT_DB_DSN="mysql:host=db;port=3306;dbname=recurrence_test"
CRAFT_DB_USER="db"
CRAFT_DB_PASSWORD="db"
CRAFT_DB_TABLE_PREFIX=""

CRAFT_SECURITY_KEY="recurrence-tests"
